# Where the browser should send API calls.
#
# In development you normally do NOT need this: vite.config.ts proxies /api to the backend,
# so the default of "/api" works with the dev server running.
#
# Set it when the API lives somewhere else — a built frontend served by another web server,
# or a backend on a different host.
VITE_API_BASE_URL=http://localhost:5080/api

# Where the dev proxy forwards /api. Only needed if the backend is not on port 5080.
# VITE_API_PROXY_TARGET=http://localhost:5080
