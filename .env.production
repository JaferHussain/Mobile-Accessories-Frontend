# Built into the bundle by `npm run build` — Vite bakes this in at BUILD time, so a change here
# needs a rebuild, not a restart.
#
# Used for two things, which is why it must be the API root and nothing else:
#   * every API call            -> <this value>
#   * every product picture     -> <this value with the trailing /api stripped>/content/products/...
#     (ProductPicture.staticOrigin does the stripping; images are static files, not /api routes)
VITE_API_BASE_URL=https://mobileaccessoriesbackend.asyntexconsultancy.com/api
